# Database and authentication
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mealmitra?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Public application URL; used by CORS and password-reset links.
CLIENT_URL=https://your-vercel-project.vercel.app
PORT=5000
NODE_ENV=production

# Payments
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# Password reset emails
EMAIL_USER=your-sender@example.com
EMAIL_APP_PASS=replace-with-an-app-password

# Chatbot
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
